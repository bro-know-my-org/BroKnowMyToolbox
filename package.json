{
  "name": "bro-know-my-toolbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @bkmt/desktop build",
    "dev": "pnpm --filter @bkmt/desktop dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "release:verify": "node scripts/verify-version.mjs",
    "test": "pnpm -r --if-present test && pnpm run test:release && pnpm run test:docs",
    "test:docs": "node --test scripts/documentation-links.test.mjs && node scripts/check-documentation-links.mjs",
    "test:release": "node --test scripts/release-scripts.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "tauri": "pnpm --filter @bkmt/desktop tauri"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.54.0"
  }
}
